{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_config.schema.json",
  "type": "object",
  "required": [
    "schema_version", "policy_version", "robot_model", "geometry", "dynamics",
    "fixed_action_duration_ms", "planner", "tokenization"
  ],
  "properties": {
    "schema_version": {"const": "robot-config/1.0.0"},
    "policy_version": {"const": "canonical_dfs_time_v1"},
    "robot_model": {"type": "string", "minLength": 1},
    "geometry": {
      "type": "object",
      "required": ["radius_mm", "safety_margin_mm", "door_anchor_offset_mm"],
      "properties": {
        "radius_mm": {"type": "integer", "minimum": 1},
        "safety_margin_mm": {"type": "integer", "minimum": 0},
        "door_anchor_offset_mm": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "dynamics": {
      "type": "object",
      "required": [
        "linear_speed_mm_per_s", "angular_speed_mdeg_per_s",
        "door_crossing_speed_mm_per_s"
      ],
      "properties": {
        "linear_speed_mm_per_s": {"type": "integer", "minimum": 1},
        "angular_speed_mdeg_per_s": {"type": "integer", "minimum": 1},
        "door_crossing_speed_mm_per_s": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "fixed_action_duration_ms": {
      "type": "object",
      "required": [
        "SELECT_EXTERIOR_DOOR", "SELECT_INTERIOR_DOOR", "LOOK_FRONT",
        "LOOK_LEFT", "LOOK_RIGHT", "STOP"
      ],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "planner": {
      "type": "object",
      "required": ["motion_model", "objective", "loop_shortcuts"],
      "properties": {
        "motion_model": {"const": "rectilinear"},
        "objective": {"const": "minimum_execution_time"},
        "loop_shortcuts": {"const": false}
      },
      "additionalProperties": false
    },
    "tokenization": {
      "type": "object",
      "required": [
        "duration_bin_boundaries_ms", "length_bin_boundaries_mm",
        "width_bin_boundaries_mm", "position_bin_boundaries_per_mille",
        "max_local_rooms", "max_local_doors", "max_local_openings"
      ],
      "properties": {
        "duration_bin_boundaries_ms": {
          "type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}
        },
        "length_bin_boundaries_mm": {
          "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}
        },
        "width_bin_boundaries_mm": {
          "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}
        },
        "position_bin_boundaries_per_mille": {
          "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}
        },
        "max_local_rooms": {"type": "integer", "minimum": 1},
        "max_local_doors": {"type": "integer", "minimum": 1},
        "max_local_openings": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
