{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior_tokens.schema.json",
  "type": "object",
  "required": [
    "schema_version", "policy_version", "vocabulary_version", "task_mode",
    "source_trajectory_sha256", "sample_id", "tokens", "token_ids"
  ],
  "properties": {
    "schema_version": {"const": "behavior-tokens/1.0.0"},
    "policy_version": {"const": "canonical_dfs_time_v1"},
    "vocabulary_version": {"const": "behavior-time-v1"},
    "task_mode": {"enum": ["pure_action", "action_perception"]},
    "source_trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_id": {"type": "string", "minLength": 1},
    "tokens": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "token_ids": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}}
  },
  "additionalProperties": false
}
