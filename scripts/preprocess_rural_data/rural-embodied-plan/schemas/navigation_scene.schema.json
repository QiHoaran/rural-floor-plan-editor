{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "navigation_scene.schema.json",
  "type": "object",
  "required": [
    "schema_version", "building_id", "coordinate_unit", "bounds", "rooms",
    "wall_segments", "openings", "exterior_doors", "interior_doors",
    "room_adjacency", "warnings"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "building_id": {"type": "string", "minLength": 1},
    "coordinate_unit": {"const": "mm"},
    "bounds": {"type": "object"},
    "rooms": {"type": "array", "items": {"type": "object", "required": ["id", "polygon", "area_mm2"]}},
    "wall_segments": {"type": "array", "items": {"type": "object", "required": ["id", "segment", "global_direction"]}},
    "openings": {"type": "array", "items": {"type": "object", "required": ["id", "opening_type", "room_ids", "center"]}},
    "exterior_doors": {"type": "array", "items": {"type": "string"}},
    "interior_doors": {"type": "array", "items": {"type": "string"}},
    "room_adjacency": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
