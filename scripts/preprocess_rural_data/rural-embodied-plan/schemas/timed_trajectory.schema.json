{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timed_trajectory.schema.json",
  "type": "object",
  "required": [
    "schema_version", "policy_version", "building_id", "robot_config_sha256",
    "primary_exterior_door_local_id", "events", "visited_room_local_ids",
    "processed_door_local_ids", "loop_closure_count", "local_id_map", "warnings"
  ],
  "properties": {
    "schema_version": {"const": "timed-trajectory/1.0.0"},
    "policy_version": {"const": "canonical_dfs_time_v1"},
    "building_id": {"type": "string", "minLength": 1},
    "robot_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_exterior_door_local_id": {"const": "DOOR_0"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step", "phase", "navigation_reason", "state_before", "action",
          "observation", "timing", "state_after"
        ]
      }
    },
    "visited_room_local_ids": {"type": "array", "items": {"type": "string"}},
    "processed_door_local_ids": {"type": "array", "items": {"type": "string"}},
    "loop_closure_count": {"type": "integer", "minimum": 0},
    "local_id_map": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
